{% extends 'base.html.twig' %}

{% block title %}Enchères - Abstract Art Gallery{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auction-harmonized.css') }}">
    <style>
        .catalog-intro {
            padding: 42px 0 16px;
        }
        .catalog-intro h1 {
            font-size: clamp(3.5rem, 6vw, 6rem);
            line-height: 0.88;
            margin-bottom: 12px;
            letter-spacing: -0.05em;
        }
        .catalog-intro p {
            color: var(--aag-text-muted);
            font-size: 1.12rem;
            max-width: 820px;
            line-height: 1.8;
        }
        .section-shell {
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid rgba(209,169,93,0.18);
        }
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin: 0 0 26px;
        }
        .section-header h2 {
            font-size: clamp(2.1rem, 3vw, 3.25rem);
            line-height: 0.92;
            letter-spacing: -0.04em;
        }
        .section-counter {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 42px;
            height: 42px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(209,169,93,0.12);
            border: 1px solid rgba(209,169,93,0.32);
            color: var(--aag-accent-soft);
            font-size: 0.72rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            font-weight: 700;
        }
        .auctions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }
        .auction-card {
            display: block;
            background: linear-gradient(180deg, rgba(18,16,13,0.92), rgba(17,17,17,0.8));
            border: 1px solid rgba(209,169,93,0.2);
            border-radius: 28px;
            overflow: hidden;
            transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
            box-shadow: 0 22px 38px rgba(0,0,0,0.10);
            text-decoration: none;
            color: inherit;
        }
        .auction-card:hover {
            transform: translateY(-8px);
            border-color: rgba(209,169,93,0.8);
            box-shadow: 0 34px 52px rgba(0,0,0,0.18);
        }
        .auction-card-image {
            position: relative;
            height: 420px;
            overflow: hidden;
            background: #111;
        }
        .auction-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.7s ease;
        }
        .auction-card:hover .auction-card-image img {
            transform: scale(1.04);
        }
        .auction-card-body {
            display: grid;
            gap: 12px;
            padding: 18px 18px 20px;
        }
        .auction-card-meta {
            color: var(--aag-accent);
            font-size: 0.68rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            font-weight: 700;
        }
        .auction-card-title {
            font-size: clamp(1.8rem, 2vw, 2.3rem);
            line-height: 0.96;
            letter-spacing: -0.04em;
        }
        .auction-card-artist {
            color: var(--aag-text-soft);
            font-size: 0.95rem;
        }
        .auction-card-prices {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 12px;
            padding-top: 8px;
            border-top: 1px solid var(--aag-border);
        }
        .price-block {
            display: grid;
            gap: 4px;
        }
        .price-label {
            color: var(--aag-text-muted);
            font-size: 0.68rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        .price-value {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--aag-text);
        }
        .status-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid transparent;
            font-size: 0.62rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 700;
        }
        .status-SCHEDULED {
            background: rgba(209,169,93,0.12);
            border-color: rgba(209,169,93,0.32);
            color: var(--aag-accent-soft);
        }
        .status-ACTIVE {
            background: rgba(239,68,68,0.1);
            border-color: rgba(239,68,68,0.3);
            color: #f7b4b4;
        }
        .status-ENDED {
            background: rgba(255,255,255,0.03);
            border-color: rgba(255,255,255,0.08);
            color: var(--aag-text-soft);
        }
        .status-CANCELLED {
            background: rgba(255,255,255,0.03);
            border-color: rgba(255,255,255,0.12);
            color: var(--aag-text-muted);
        }
        .countdown-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border-radius: 999px;
            border: 1px solid rgba(209,169,93,0.2);
            background: rgba(255,255,255,0.02);
            color: var(--aag-text-soft);
            font-size: 0.7rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 700;
        }
        .countdown-chip.urgent {
            background: rgba(239,68,68,0.08);
            border-color: rgba(239,68,68,0.28);
            color: #f7b4b4;
        }
        .empty-state {
            border: 1px solid var(--aag-border);
            background: rgba(255,255,255,0.02);
            text-align: center;
            padding: 46px 20px;
            color: var(--aag-text-muted);
        }
        @media (max-width: 700px) {
            .section-header { align-items: flex-start; flex-direction: column; }
            .auction-card-image { height: 320px; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="auction-harmonized-page">
    <section class="catalog-intro">
        <span class="aag-section-label">Enchères</span>
        <h1>Ventes en direct.</h1>
        <p>Découvrez les œuvres sélectionnées pour la prochaine vente, les enchères actuellement ouvertes et les lots clôturés.</p>
    </section>

    <div class="auction-front-shell">
    <div class="section-shell">
        <div class="section-header">
            <h2>Enchères en Direct</h2>
            <span class="section-counter">{{ liveAuctions|length }}</span>
        </div>

        {% if liveAuctions|length > 0 %}
            <div class="auctions-grid">
                {% for auction in liveAuctions %}
                    {% set status = auction.effectiveStatus|default(auction.status) %}
                    {% set statusLabel = status == 'SCHEDULED' ? 'Planifiée' : (status == 'ACTIVE' ? 'En direct' : (status == 'ENDED' ? 'Terminée' : 'Annulée')) %}
                    <a href="{{ path('app_auction_show', {id: auction.id}) }}" class="auction-card">
                        <div class="auction-card-image">
                            {% set img = auction.artwork.images|first %}
                            {% if img %}
                                {% set imagePath = img.filePath %}
                                {% set imageSrc = imagePath starts with 'http' ? imagePath : (imagePath starts with '/' ? asset(imagePath|trim('/')) : (imagePath starts with 'uploads/' ? asset(imagePath) : asset('uploads/artworks/' ~ imagePath))) %}
                                <img src="{{ imageSrc }}" alt="{{ auction.artwork.title }}">
                            {% elseif auction.artwork.photo %}
                                <img src="{{ asset('uploads/artworks/' ~ auction.artwork.photo) }}" alt="{{ auction.artwork.title }}">
                            {% else %}
                                <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=900&q=80" alt="{{ auction.artwork.title }}">
                            {% endif %}
                        </div>
                        <div class="auction-card-body">
                            <div class="auction-card-meta">Lot {{ auction.artwork.id }}</div>
                            <div class="auction-card-title">{{ auction.artwork.title }}</div>
                            <div class="auction-card-artist">Par {{ auction.artwork.artist.name }}</div>
                            <div class="auction-card-prices">
                                <div class="price-block">
                                    <span class="price-label">Démarrage</span>
                                    <span class="price-value">{{ auction.startingPrice|number_format(0, ',', ' ') }} €</span>
                                </div>
                                <div class="price-block">
                                    <span class="price-label">Actuelle</span>
                                    <span class="price-value">{{ (auction.currentPrice ?: auction.startingPrice)|number_format(0, ',', ' ') }} €</span>
                                </div>
                            </div>
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; margin-top:2px;">
                                <span class="status-pill status-{{ status }}">{{ statusLabel }}</span>
                                <div class="countdown-chip {% if auction.timeRemainingSeconds < 300 %}urgent{% endif %}" data-end="{{ auction.endDate.timestamp }}">
                                    <span>⏱</span>
                                    <span class="countdown-text">Calcul…</span>
                                </div>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">Aucune enchère active en ce moment.</div>
        {% endif %}
    </div>

    <div class="section-shell">
        <div class="section-header">
            <h2>Enchères à venir</h2>
            <span class="section-counter">{{ plannedAuctions|length }}</span>
        </div>

        {% if plannedAuctions|length > 0 %}
            <div class="auctions-grid">
                {% for auction in plannedAuctions %}
                    <a href="{{ path('app_auction_show', {id: auction.id}) }}" class="auction-card">
                        <div class="auction-card-image">
                            {% set img = auction.artwork.images|first %}
                            {% if img %}
                                {% set imagePath = img.filePath %}
                                {% set imageSrc = imagePath starts with 'http' ? imagePath : (imagePath starts with '/' ? asset(imagePath|trim('/')) : (imagePath starts with 'uploads/' ? asset(imagePath) : asset('uploads/artworks/' ~ imagePath))) %}
                                <img src="{{ imageSrc }}" alt="{{ auction.artwork.title }}" style="filter: grayscale(15%);">
                            {% elseif auction.artwork.photo %}
                                <img src="{{ asset('uploads/artworks/' ~ auction.artwork.photo) }}" alt="{{ auction.artwork.title }}" style="filter: grayscale(15%);">
                            {% else %}
                                <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=900&q=80" alt="{{ auction.artwork.title }}" style="filter: grayscale(15%);">
                            {% endif %}
                        </div>
                        <div class="auction-card-body">
                            <div class="auction-card-meta">À venir</div>
                            <div class="auction-card-title">{{ auction.artwork.title }}</div>
                            <div class="auction-card-artist">Par {{ auction.artwork.artist.name }}</div>
                            <div class="auction-card-prices">
                                <div class="price-block">
                                    <span class="price-label">Début</span>
                                    <span class="price-value">{{ auction.startDate|date('d/m/Y à H:i') }}</span>
                                </div>
                                <div class="price-block">
                                    <span class="price-label">Mise</span>
                                    <span class="price-value">{{ auction.startingPrice|number_format(0, ',', ' ') }} €</span>
                                </div>
                            </div>
                            <span class="status-pill status-SCHEDULED">Planifiée</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">Aucune vente à venir pour le moment.</div>
        {% endif %}
    </div>

    {% if finishedAuctions|length > 0 %}
        <div class="section-shell">
            <div class="section-header">
                <h2>Enchères terminées</h2>
                <span class="section-counter">{{ finishedAuctions|length }}</span>
            </div>
            <div class="auctions-grid">
                {% for auction in finishedAuctions %}
                    <a href="{{ path('app_auction_show', {id: auction.id}) }}" class="auction-card" style="opacity: 0.78;">
                        <div class="auction-card-image">
                            {% set img = auction.artwork.images|first %}
                            {% if img %}
                                {% set imagePath = img.filePath %}
                                {% set imageSrc = imagePath starts with 'http' ? imagePath : (imagePath starts with '/' ? asset(imagePath|trim('/')) : (imagePath starts with 'uploads/' ? asset(imagePath) : asset('uploads/artworks/' ~ imagePath))) %}
                                <img src="{{ imageSrc }}" alt="{{ auction.artwork.title }}" style="filter: grayscale(60%);">
                            {% elseif auction.artwork.photo %}
                                <img src="{{ asset('uploads/artworks/' ~ auction.artwork.photo) }}" alt="{{ auction.artwork.title }}" style="filter: grayscale(60%);">
                            {% else %}
                                <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=900&q=80" alt="{{ auction.artwork.title }}" style="filter: grayscale(60%);">
                            {% endif %}
                        </div>
                        <div class="auction-card-body">
                            <div class="auction-card-meta">Terminé</div>
                            <div class="auction-card-title">{{ auction.artwork.title }}</div>
                            <div class="auction-card-artist">Par {{ auction.artwork.artist.name }}</div>
                            <div class="auction-card-prices">
                                <div class="price-block">
                                    <span class="price-label">Prix final</span>
                                    <span class="price-value">{{ (auction.currentPrice ?: auction.startingPrice)|number_format(0, ',', ' ') }} €</span>
                                </div>
                                <span class="status-pill status-ENDED">Terminée</span>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function formatTime(seconds) {
                if (seconds <= 0) return 'Terminé';
                var h = Math.floor(seconds / 3600);
                var m = Math.floor((seconds % 3600) / 60);
                var s = seconds % 60;
                var parts = [];
                if (h > 0) parts.push(h + 'h');
                if (m > 0 || h > 0) parts.push((m < 10 && h > 0 ? '0' : '') + m + 'm');
                parts.push((s < 10 ? '0' : '') + s + 's');
                return parts.join(' ');
            }

            document.querySelectorAll('[data-end]').forEach(function (el) {
                var endTs = parseInt(el.dataset.end, 10) * 1000;
                var span = el.querySelector('.countdown-text');

                function tick() {
                    var remaining = Math.floor((endTs - Date.now()) / 1000);
                    span.textContent = formatTime(remaining);
                    if (remaining <= 300) {
                        el.classList.add('urgent');
                    }
                    if (remaining > 0) {
                        setTimeout(tick, 1000);
                    }
                }

                tick();
            });
        });
    </script>
    </div>
    </div>
{% endblock %}
