{% extends 'base.html.twig' %}

{% block title %}Artistes - Abstract Art Gallery{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .artists-header {
            margin-bottom: 48px;
            padding-top: 12px;
        }

        .artists-header h1 {
            font-size: clamp(3rem, 4vw, 5.2rem);
            line-height: 0.92;
            letter-spacing: -0.06em;
            font-weight: 600;
            color: #f5f5f5;
            margin: 0 0 12px;
        }

        .artists-header p {
            margin: 0;
            color: #999999;
            font-size: 1.08rem;
            letter-spacing: 0.01em;
        }

        .artists-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 34px;
            align-items: stretch;
        }

        .artist-card-full {
            display: flex;
            flex-direction: column;
            background: linear-gradient(180deg, rgba(18,18,18,0.92), rgba(12,12,12,0.8));
            border: 1px solid rgba(217,179,106,0.26);
            border-radius: 28px;
            overflow: hidden;
            transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
            box-shadow: 0 26px 52px rgba(0, 0, 0, 0.14);
            min-width: 0;
        }

        .artist-card-full:hover {
            transform: translateY(-8px);
            border-color: rgba(217,179,106,0.82);
            box-shadow: 0 36px 62px rgba(0, 0, 0, 0.22);
        }

        .artist-card__media {
            position: relative;
            overflow: hidden;
            aspect-ratio: 4 / 5;
            background: #0b0b0b;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .artist-card__media img,
        .artist-card__fallback {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform 0.5s ease, filter 0.5s ease;
        }

        .artist-card__fallback {
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
            color: #f5f5f5;
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: 500;
            letter-spacing: -0.08em;
        }

        .artist-card-full:hover .artist-card__media img,
        .artist-card-full:hover .artist-card__fallback {
            transform: scale(1.04);
        }

        .artist-card__overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(8,8,8,0.12) 0%, rgba(8,8,8,0.55) 100%);
            opacity: 0;
            transition: opacity 0.28s ease;
        }

        .artist-card-full:hover .artist-card__overlay {
            opacity: 1;
        }

        .artist-card__content {
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding: 22px 22px 18px;
            min-width: 0;
        }

        .artist-card__eyebrow {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            font-size: 0.64rem;
            color: #999999;
            margin: 0;
        }

        .artist-card__name {
            margin: 0;
            font-size: clamp(1.6rem, 1.8vw, 2.2rem);
            line-height: 1.05;
            letter-spacing: -0.06em;
            color: #f5f5f5;
            font-weight: 500;
        }

        .artist-card__country {
            display: inline-block;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #bbbbbb;
        }

        .artist-card__bio {
            margin: 0;
            color: #999999;
            font-size: 0.92rem;
            line-height: 1.7;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 4.8em;
        }

        .artist-card__footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .artist-card__count {
            color: #bbbbbb;
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .artist-card__link {
            color: #f5f5f5;
            text-decoration: none;
            font-size: 0.78rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            opacity: 0.9;
            transition: opacity 0.22s ease, transform 0.22s ease;
        }

        .artist-card-full:hover .artist-card__link {
            opacity: 1;
        }

        .artist-card__link:hover {
            transform: translateX(2px);
        }

        @media (max-width: 1024px) {
            .artists-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 22px;
            }
        }

        @media (max-width: 640px) {
            .artists-header {
                margin-bottom: 28px;
            }

            .artists-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .artist-card__content {
                padding: 18px 18px 16px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="artists-header">
    <h1>Les Artistes de la Galerie</h1>
    <p>Découvrez les maîtres et créateurs émergents de l'art abstrait.</p>
</div>

<div class="artists-grid">
    {% for item in artistsWithCount %}
        {% set artist = item.artist %}
        {% set count = item.artworksCount %}
        <article class="artist-card-full">
            <div class="artist-card__media">
                {% if artist.photo %}
                    <img src="{{ asset('uploads/artists/' ~ artist.photo) }}" alt="{{ artist.name }}" loading="lazy">
                {% else %}
                    <div class="artist-card__fallback" aria-label="{{ artist.name }}">{{ artist.name|slice(0, 1) }}</div>
                {% endif %}
                <div class="artist-card__overlay" aria-hidden="true"></div>
            </div>

            <div class="artist-card__content">
                <span class="artist-card__eyebrow">Artist</span>
                <h2 class="artist-card__name">{{ artist.name }}</h2>
                <span class="artist-card__country">{{ artist.country|default('International') }}</span>

                <p class="artist-card__bio">
                    {{ artist.biography|default('Artiste contemporain spécialisé dans l\'exploration des formes et de la matière.')|striptags|slice(0, 160) }}{% if artist.biography is not empty and artist.biography|length > 160 %}...{% endif %}
                </p>

                <div class="artist-card__footer">
                    <span class="artist-card__count">{{ count }} œuvre{% if count != 1 %}s{% endif %}</span>
                    <a href="{{ path('app_artist_show', {id: artist.id}) }}" class="artist-card__link">Voir le profil →</a>
                </div>
            </div>
        </article>
    {% endfor %}
</div>
{% endblock %}
