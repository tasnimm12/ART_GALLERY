<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Reçu de paiement — Commande {{ order.orderNumber ?? order.getOrderNumber() }}</title>
    <style>
        body { background:#0b0b0b; color:#ffffff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
        .container{ max-width:680px; margin:24px auto; padding:24px; background:#050505; border:1px solid #111; border-radius:10px; }
        .brand{ color:#E0C766; font-weight:700; font-size:16px; margin-bottom:8px; }
        h1{ color:#ffffff; font-size:20px; margin:6px 0 14px 0; }
        .card{ background:#111111; padding:16px; border-radius:8px; margin-bottom:12px; }
        table{ width:100%; border-collapse:collapse; }
        th, td{ padding:8px 6px; text-align:left; border-bottom:1px solid #1a1a1a; }
        .muted{ color:#A3A3A3; font-size:13px; }
        .total{ color:#E0C766; font-weight:700; }
        .footer{ color:#A3A3A3; font-size:13px; margin-top:18px; }
        a.button{ display:inline-block; padding:10px 14px; background:#C9A227; color:#050505; text-decoration:none; border-radius:6px; margin-top:8px; }
    </style>
</head>
<body>
<div class="container">
    <div class="brand">ABSTRACT ART GALLERY — BACK OFFICE</div>
    <h1>Reçu de paiement</h1>

    <div class="card">
        <div class="muted">Commande</div>
        <div><strong>#{{ order.orderNumber ?? order.getOrderNumber() }}</strong></div>
        <div class="muted">Date: {{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '—' }}</div>
    </div>

    <div class="card">
        <div class="muted">Détails</div>
        <table>
            <thead>
                <tr><th>Article</th><th style="text-align:right">Prix</th></tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td>{{ item }}</td>
                    <td style="text-align:right">&nbsp;</td>
                </tr>
            {% else %}
                <tr><td colspan="2">Aucun article</td></tr>
            {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td class="total">Total</td>
                    <td class="total" style="text-align:right">{{ order.totalAmount|number_format(2, ',', ' ') }} {{ order.currency }}</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <p class="footer">Merci pour votre achat. Si vous avez des questions concernant cette commande, répondez à cet e-mail ou contactez notre support.</p>
</div>
</body>
</html>