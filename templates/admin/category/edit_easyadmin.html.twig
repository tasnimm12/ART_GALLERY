{% extends '@!EasyAdmin/crud/edit.html.twig' %}
{% form_theme edit_form with ea.crud.formThemes only %}

{% block configured_stylesheets %}
    {{ parent() }}
    <style>
        .form-container { max-width: 800px; margin: 40px auto; background: #111111; padding: 35px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.10); box-shadow: 0 16px 40px rgba(0, 0, 0, 0.50); color: #FFFFFF; }
        .form-header h1 { font-size: 26px; font-weight: 800; color: #FFFFFF; margin: 0 0 6px 0; letter-spacing: -0.02em; }
        .form-header p { font-size: 14px; color: #A3A3A3; margin: 0 0 18px 0; }
        .form-divider { height: 1px; background: rgba(255, 255, 255, 0.10); margin: 18px 0 22px 0; border: none; }
        .form-row { margin-bottom: 20px; }
        .form-row label { display: block; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #A3A3A3; margin-bottom: 8px; }
        .form-row .field-widget { width: 100%; padding: 12px 16px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.12); font-size: 14px; outline: none; background: #0B0B0B; color: #FFFFFF; box-sizing: border-box; transition: border-color 0.15s ease, box-shadow 0.15s ease; }
        .form-row .field-widget:focus { border-color: #C9A227; background: #0E0E0E; box-shadow: 0 0 0 2px rgba(201, 162, 39, 0.18); }
        .field-widget.is-invalid { border-color: rgba(255, 255, 255, 0.40); background: #0E0E0E; box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.10); }
        textarea.form-textarea { min-height: 140px; resize: vertical; line-height: 1.4; }
        .form-errors { margin-top: 6px; color: #E0C766; font-size: 12.5px; font-weight: 600; }
        .form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.10); padding-top: 20px; }
        .btn-cancel { background: #0B0B0B; color: #FFFFFF; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255, 255, 255, 0.12); transition: border-color 0.15s; }
        .btn-cancel:hover { border-color: #C9A227; color: #C9A227; }
        .btn-submit { background: #C9A227; color: #050505; padding: 12px 24px; border-radius: 8px; border: none; font-size: 14px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; transition: background 0.15s; }
        .btn-submit:hover { background: #E0C766; }
        @media (max-width: 640px) { .form-container { padding: 20px; margin: 18px; } .form-actions { flex-direction: column-reverse; align-items: stretch; } .btn-cancel, .btn-submit { width: 100%; justify-content: center; } }
    </style>
{% endblock %}

{% block main %}
    <div class="form-container" role="main" aria-labelledby="category-form-title">
        <div class="form-header">
            <h1 id="category-form-title">✏️ Modifier la Catégorie</h1>
            <p>Modifiez les informations de la catégorie et vérifiez les champs avant validation.</p>
            <div class="form-divider" aria-hidden="true"></div>
        </div>

        {{ form_start(edit_form, {'attr': {'class': 'category-form', 'autocomplete': 'off', 'novalidate': 'novalidate'}}) }}

            <div class="form-row">
                {{ form_label(edit_form.name) }}
                <div>
                    {{ form_widget(edit_form.name, {'attr': {'class': 'field-widget', 'data-field': 'name', 'maxlength': 100}}) }}
                    <div class="form-errors">{{ form_errors(edit_form.name) }}</div>
                </div>
            </div>

            {% if edit_form.slug is defined %}
                <div class="form-row">
                    {{ form_label(edit_form.slug) }}
                    <div>
                        {{ form_widget(edit_form.slug, {'attr': {'class': 'field-widget', 'data-field': 'slug', 'maxlength': 150}}) }}
                        <div class="form-errors">{{ form_errors(edit_form.slug) }}</div>
                    </div>
                </div>
            {% endif %}

            {% if edit_form.description is defined %}
                <div class="form-row">
                    {{ form_label(edit_form.description) }}
                    <div>
                        {{ form_widget(edit_form.description, {'attr': {'class': 'field-widget form-textarea', 'data-field': 'description', 'maxlength': 1000}}) }}
                        <div class="form-errors">{{ form_errors(edit_form.description) }}</div>
                    </div>
                </div>
            {% endif %}

            <div class="form-actions" role="group" aria-label="Actions du formulaire">
                <a href="javascript:history.back()" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-submit">Enregistrer les modifications</button>
            </div>

        {{ form_end(edit_form) }}
    </div>
{% endblock %}

{% block configured_javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.category-form');
            if (!form) {
                return;
            }

            const setError = function (field, message) {
                if (!field) {
                    return;
                }
                field.classList.add('is-invalid');
                const row = field.closest('.form-row');
                if (!row) {
                    return;
                }
                const errorBox = row.querySelector('.form-errors');
                if (errorBox) {
                    errorBox.textContent = message;
                }
            };

            const clearError = function (field) {
                if (!field) {
                    return;
                }
                field.classList.remove('is-invalid');
                const row = field.closest('.form-row');
                if (!row) {
                    return;
                }
                const errorBox = row.querySelector('.form-errors');
                if (errorBox) {
                    errorBox.textContent = '';
                }
            };

            const slugify = function (value) {
                return (value || '')
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase()
                    .replace(/[^a-z0-9\s\-]/g, '')
                    .replace(/[\s_]+/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-+|-+$/g, '');
            };

            const nameField = form.querySelector('#category_name');
            const slugField = form.querySelector('#category_slug');
            const descriptionField = form.querySelector('#category_description');

            if (nameField && slugField) {
                nameField.addEventListener('input', function () {
                    const current = (slugField.value || '').trim();
                    const generated = slugify(nameField.value || '');
                    if (!current || current === slugify(current)) {
                        slugField.value = generated;
                    }
                    clearError(nameField);
                    clearError(slugField);
                });
            }

            const validateForm = function () {
                let valid = true;
                [nameField, slugField, descriptionField].forEach(clearError);

                if (nameField) {
                    const name = (nameField.value || '').trim();
                    if (!name) {
                        setError(nameField, 'Le nom de la catégorie est obligatoire.');
                        valid = false;
                    } else if (name.length < 2) {
                        setError(nameField, 'Le nom doit contenir au moins 2 caractères.');
                        valid = false;
                    } else if (name.length > 100) {
                        setError(nameField, 'Le nom ne peut pas dépasser 100 caractères.');
                        valid = false;
                    } else if (!/^[\p{L}\s\'\-]+$/u.test(name)) {
                        setError(nameField, 'Le nom contient des caractères invalides.');
                        valid = false;
                    }
                }

                if (slugField) {
                    const slug = (slugField.value || '').trim();
                    if (!slug) {
                        setError(slugField, 'Le slug est obligatoire.');
                        valid = false;
                    } else if (!/^[a-z0-9\-]+$/.test(slug)) {
                        setError(slugField, 'Le slug contient des caractères invalides.');
                        valid = false;
                    }
                }

                if (descriptionField && descriptionField.value && descriptionField.value.length > 1000) {
                    setError(descriptionField, 'La description ne peut pas dépasser 1000 caractères.');
                    valid = false;
                }

                return valid;
            };

            [nameField, slugField, descriptionField].forEach(function (field) {
                if (!field) {
                    return;
                }
                field.addEventListener('input', function () { clearError(field); });
                field.addEventListener('change', function () { clearError(field); });
            });

            form.addEventListener('submit', function (event) {
                if (!validateForm()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
            });
        });
    </script>
{% endblock %}
