{# templates/admin/category/new_easyadmin.html.twig #}
{% extends '@!EasyAdmin/crud/new.html.twig' %}
{% form_theme new_form with ea.crud.formThemes only %}

{% block configured_stylesheets %}
    {{ parent() }}
    <style>
        .form-container { max-width:800px; margin:40px auto; background:#111111; padding:35px; border-radius:16px; border:1px solid rgba(255,255,255,0.10); box-shadow:0 16px 40px rgba(0,0,0,0.50); color:#FFFFFF; } 
        .form-header h1{font-size:26px;font-weight:800;color:#FFFFFF;margin:0 0 6px 0;letter-spacing:-0.02em}
        .form-header p{font-size:14px;color:#A3A3A3;margin:0 0 18px 0}
        .form-divider{height:1px;background:rgba(255,255,255,0.10);margin:18px 0 22px 0;border:none}
        .form-row{margin-bottom:20px}
        .form-row label{display:block;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#A3A3A3;margin-bottom:8px}
        .form-row .field-widget{width:100%;padding:12px 16px;border-radius:8px;border:1px solid rgba(255,255,255,0.12);font-size:14px;outline:none;transition:border-color .15s, box-shadow .15s;background:#0B0B0B;color:#FFFFFF;box-sizing:border-box}
        .form-row .field-widget:focus{border-color:#C9A227;background:#0E0E0E;box-shadow:0 0 0 2px rgba(201,162,39,0.18)}
        textarea.form-textarea{min-height:140px;resize:vertical;line-height:1.4}
        .form-errors{margin-top:6px;color:#E0C766;font-size:12.5px;font-weight:600}
        .form-actions{display:flex;justify-content:flex-end;gap:12px;margin-top:24px;border-top:1px solid rgba(255,255,255,0.10);padding-top:20px}
        .btn-cancel{background:#0B0B0B;color:#FFFFFF;padding:12px 20px;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,0.12);transition:border-color 0.15s}
        .btn-cancel:hover{border-color:#C9A227;color:#C9A227}
        .btn-submit{background:#C9A227;color:#050505;padding:12px 24px;border-radius:8px;border:none;font-size:14px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:10px;transition:background 0.15s}
        .btn-submit:hover{background:#E0C766}
        @media(max-width:640px){.form-container{padding:20px;margin:18px}.form-actions{flex-direction:column-reverse;align-items:stretch}.btn-cancel,.btn-submit{width:100%;justify-content:center}}
    </style>
{% endblock %}

{% block main %}
    <div class="form-container" role="main" aria-labelledby="category-form-title">
        <div class="form-header">
            <h1 id="category-form-title">📁 Ajouter une Catégorie</h1>
            <p>Ajoutez une nouvelle catégorie au catalogue de la galerie.</p>
            <div class="form-divider" aria-hidden="true"></div>
        </div>

        {{ form_start(new_form, {'attr': {'class': 'category-form', 'autocomplete': 'off', 'novalidate':'novalidate'}}) }}

            <div class="form-row">
                {{ form_label(new_form.name) }}
                <div>
                    {{ form_widget(new_form.name, {'attr': {'class': 'field-widget'}}) }}
                    <div class="form-errors">{{ form_errors(new_form.name) }}</div>
                </div>
            </div>

            {% if new_form.slug is defined %}
                <div class="form-row">
                    {{ form_label(new_form.slug) }}
                    <div>
                        {{ form_widget(new_form.slug, {'attr': {'class': 'field-widget'}}) }}
                        <div class="form-errors">{{ form_errors(new_form.slug) }}</div>
                    </div>
                </div>
            {% endif %}

            {% if new_form.description is defined %}
                <div class="form-row">
                    {{ form_label(new_form.description) }}
                    <div>
                        {{ form_widget(new_form.description, {'attr': {'class': 'field-widget form-textarea'}}) }}
                        <div class="form-errors">{{ form_errors(new_form.description) }}</div>
                    </div>
                </div>
            {% endif %}

            <div class="form-actions" role="group" aria-label="Actions du formulaire">
                <a href="javascript:history.back()" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-submit">Ajouter la catégorie</button>
            </div>
 
        {{ form_end(new_form) }}
    </div>
{% endblock %}

{% block configured_javascripts %}
    {{ parent() }}
    <script>
        (function(){
            function slugify(s){
                s = s.toString();
                // Normalize accents
                try{ s = s.normalize('NFD').replace(/\p{Diacritic}/gu, ''); }catch(e){ s = s; }
                s = s.toLowerCase();
                s = s.replace(/[^a-z0-9\s\-]/g, '');
                s = s.replace(/[\s_]+/g, '-');
                s = s.replace(/\-+/g, '-');
                s = s.replace(/^\-+|\-+$/g, '');
                return s;
            }

            function setFieldError(fieldEl, message){ if(!fieldEl) return; fieldEl.classList.add('is-invalid'); var row = fieldEl.closest('.form-row'); if(!row) return; var errors = row.querySelector('.form-errors'); if(errors){ errors.innerHTML = '<span style="display:inline-block;width:14px;height:14px;background:#E0C766;border-radius:50%;margin-right:6px;vertical-align:-2px"></span>'+message; } }
            function clearFieldError(fieldEl){ if(!fieldEl) return; fieldEl.classList.remove('is-invalid'); var row = fieldEl.closest('.form-row'); if(!row) return; var errors = row.querySelector('.form-errors'); if(errors){ errors.innerHTML = ''; } }

            document.addEventListener('DOMContentLoaded', function(){
                var form = document.querySelector('.category-form'); if(!form) return;
                form.setAttribute('novalidate','novalidate');

                var nameEl = form.querySelector('[data-field="name"]');
                var slugEl = form.querySelector('[data-field="slug"]');
                var descEl = form.querySelector('[data-field="description"]');
                var counter = null;
                if(descEl){ counter = document.createElement('div'); counter.style.color = '#A3A3A3'; counter.style.fontSize = '12px'; counter.style.marginTop = '6px'; descEl.parentNode.appendChild(counter); }

                function updateCounter(){ if(!descEl || !counter) return; var len = descEl.value ? descEl.value.length : 0; counter.textContent = len+' / 1000'; counter.style.color = (len>1000)?'#E0C766':'#A3A3A3'; }
                if(descEl) { descEl.addEventListener('input', updateCounter); updateCounter(); }

                if(nameEl && slugEl){
                    nameEl.addEventListener('input', function(){
                        clearFieldError(nameEl);
                        // Only generate slug when slug is empty or equals previous generated
                        try{
                            var currentSlug = slugEl.value || '';
                            var generated = slugify(nameEl.value || '');
                            if(currentSlug === '' || currentSlug.indexOf('-')>-1 && currentSlug === slugify(currentSlug)){
                                slugEl.value = generated;
                                clearFieldError(slugEl);
                            }
                        }catch(e){}
                    });
                }

                form.addEventListener('submit', function(e){
                    var valid = true;
                    // Name validation
                    if(nameEl){ clearFieldError(nameEl); var v = (nameEl.value||'').trim(); if(!v){ setFieldError(nameEl, "Le nom de la catégorie est obligatoire."); valid=false;} else if(v.length<2){ setFieldError(nameEl, "Le nom doit contenir au moins 2 caractères."); valid=false; } else if(v.length>100){ setFieldError(nameEl, "Le nom ne peut pas dépasser 100 caractères."); valid=false; } else if(!/^[\p{L}\s'\-]+$/u.test(v)){ setFieldError(nameEl, "Le nom contient des caractères invalides."); valid=false; } }

                    // Slug validation
                    if(slugEl){ clearFieldError(slugEl); var s = (slugEl.value||'').trim(); if(!s){ setFieldError(slugEl, "Le slug est obligatoire."); valid=false; } else if(!/^[a-z0-9\-]+$/.test(s)){ setFieldError(slugEl, "Le slug contient des caractères invalides."); valid=false; } }

                    // Description
                    if(descEl){ clearFieldError(descEl); var d = descEl.value||''; if(d.length>1000){ setFieldError(descEl, "La description ne peut pas dépasser 1000 caractères."); valid=false; } }

                    if(!valid){ e.preventDefault(); var first = form.querySelector('.is-invalid'); if(first) first.focus(); }
                });

                // live clear errors
                [nameEl, slugEl, descEl].forEach(function(el){ if(!el) return; var ev = (el.tagName||'').toLowerCase()==='textarea' ? 'input' : 'input'; el.addEventListener(ev, function(){ clearFieldError(el); }); });
            });
        })();
    </script>
{% endblock %}