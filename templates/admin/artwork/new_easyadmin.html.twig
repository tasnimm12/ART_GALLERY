{# templates/admin/artwork/new_easyadmin.html.twig #}
{% extends '@!EasyAdmin/crud/new.html.twig' %}
{% form_theme new_form with ea.crud.formThemes only %}
{% form_theme new_form.images with 'admin/artwork/image_collection_theme.html.twig' %}

{% block configured_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/admin-artwork-images.css') }}">
    <style>
    /* Master Design for Artwork New Form */
    .form-container { max-width:1200px; width:calc(100% - 48px); margin:28px auto; background:#111111; padding:40px; border-radius:16px; border:1px solid rgba(255,255,255,0.10); box-shadow:0 16px 40px rgba(0,0,0,0.50); color:#FFFFFF; position:relative; }

    /* Header */
    .form-header { display:flex; flex-direction:column; gap:8px }
    .form-header .title-row { display:flex; align-items:center; gap:12px }
    .form-title-icon { width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center }
    .form-header h1{font-size:26px;font-weight:800;color:#FFFFFF;margin:0;letter-spacing:-0.02em}
    .form-header p{font-size:14px;color:#A3A3A3;margin:0}
    .form-divider{height:1px;background:rgba(255,255,255,0.10);margin:20px 0 24px 0;border:none}

    /* Grid layout */
    .artwork-form .form-grid { display:grid; grid-template-columns:1fr; gap:20px }
    @media(min-width:980px){ .artwork-form .form-grid { grid-template-columns: 1fr 420px; gap:24px } }

    .form-column { display:flex; flex-direction:column; gap:20px }
    .section-title { font-size:12px; color:#C9A227; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:8px }
    .section-card { background:transparent; padding:0; border-radius:10px }

    /* Labels */
    .artwork-form label { display:block; font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#A3A3A3; margin-bottom:8px }

    /* Inputs */
    .artwork-form .field-widget { width:100%; padding:12px 16px; border-radius:8px; border:1px solid rgba(255,255,255,0.12); font-size:14px; color:#FFFFFF; background:#0B0B0B; box-sizing:border-box; min-height:46px; transition: box-shadow .15s, border-color .15s; outline:none; }
    .artwork-form .daily-featured-checkbox { width:20px; min-height:20px; padding:0; accent-color:#C9A227; }
    .artwork-form .field-widget::placeholder { color:#737373; opacity:1 }
    .artwork-form .field-widget:focus { border-color:#C9A227; box-shadow:0 0 0 2px rgba(201,162,39,0.18); background:#0E0E0E; }

    textarea.form-textarea { min-height:160px; padding:14px 16px; border-radius:8px }

    /* Upload area */
    .upload-area { border:1px dashed rgba(255,255,255,0.16); background:#0B0B0B; padding:16px; border-radius:8px; min-height:140px; display:flex; align-items:center; justify-content:center; position:relative }
    .upload-area .upload-hint { color:#A3A3A3; font-size:13px }
    .upload-area input[type=file] { position:absolute; inset:0; opacity:0; cursor:pointer }
    .upload-preview { width:100%; border-radius:8px; border:1px solid rgba(255,255,255,0.10); }

    /* Errors */
    .form-errors { margin-top:6px; color:#E0C766; font-size:12.5px; font-weight:600; }
    .color-analysis-action { margin-top:12px; padding:11px 16px; border:1px solid rgba(201,162,39,.55); border-radius:8px; background:transparent; color:#E0C766; font-weight:700; cursor:pointer; }
    .color-analysis-action:hover:not(:disabled) { background:rgba(201,162,39,.1); }
    .color-analysis-action:disabled { cursor:wait; opacity:.65; }
    .color-analysis-status { margin:8px 0 0; color:#A3A3A3; font-size:12px; line-height:1.5; }

    /* Actions */
    .form-actions { display:flex; justify-content:flex-end; gap:12px; margin-top:24px; padding:16px 0; border-top:1px solid rgba(255,255,255,0.10); background:transparent; }
    .artwork-form .form-grid .form-actions { grid-column: 1 / -1; padding-left:0; padding-right:0 }
    .btn-cancel { background:#0B0B0B; color:#FFFFFF; padding:12px 20px; border-radius:8px; border:1px solid rgba(255,255,255,0.12); font-weight:600; font-size:14px; text-decoration:none; display:inline-flex; align-items:center; transition:border-color 0.15s; }
    .btn-cancel:hover { border-color:#C9A227; color:#C9A227; }
    .btn-submit { background:#C9A227; color:#050505; padding:12px 24px; border-radius:8px; border:none; font-weight:700; font-size:14px; cursor:pointer; transition:background 0.15s; }
    .btn-submit:hover { background:#E0C766; }

    @media(max-width:640px){ .form-container{ padding:20px; width:100%; margin:16px 0; } .artwork-form .form-grid{ grid-template-columns:1fr } .form-actions{ flex-direction:column-reverse; align-items:stretch; } .btn-cancel, .btn-submit{ width:100%; justify-content:center; } }

  

    /* Date fields, select inputs and autocomplete follow the global black/gold admin system */
    .artwork-form input[type="date"],
    .artwork-form input[type="datetime-local"],
    .artwork-form input[type="time"] {
        color: #FFFFFF !important;
        background-color: #0B0B0B !important;
        color-scheme: dark !important;
        min-height: 54px !important;
    }

    .artwork-form div[id*="_yearCreated"],
    .artwork-form div[id*="_publishedAt"],
    .artwork-form div[id*="_auctionStart"],
    .artwork-form div[id*="_auctionEnd"] {
        display: flex !important;
        gap: 8px !important;
        align-items: center !important;
    }

    .artwork-form div[id*="_yearCreated"] select,
    .artwork-form div[id*="_publishedAt"] select,
    .artwork-form div[id*="_auctionStart"] select,
    .artwork-form div[id*="_auctionEnd"] select,
    .artwork-form select.field-widget {
        color: #FFFFFF !important;
        background-color: #0B0B0B !important;
        color-scheme: dark !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 12px !important;
        padding: 10px 14px !important;
        min-height: 54px !important;
        font-size: 15px !important;
    }

    .artwork-form select option {
        color: #FFFFFF !important;
        background-color: #111111 !important;
    }

    .artwork-form .ts-wrapper .ts-control {
        color: #FFFFFF !important;
        background: #0B0B0B !important;
        min-height: 54px !important;
        border-radius: 12px !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        padding: 8px 14px !important;
        display: flex !important;
        align-items: center !important;
    }

    .artwork-form .ts-wrapper .ts-control .item,
    .artwork-form .ts-wrapper .ts-control input {
        color: #FFFFFF !important;
    }

    .artwork-form .ts-dropdown,
    .artwork-form .ts-dropdown .option,
    .artwork-form .ts-dropdown .no-results,
    .artwork-form .ts-dropdown .option-header {
        color: #FFFFFF !important;
        background-color: #111111 !important;
    }

    .artwork-form .ts-dropdown .option {
        padding: 10px 14px !important;
    }

    .artwork-form .ts-dropdown .active,
    .artwork-form .ts-dropdown .option:hover {
        background-color: #C9A227 !important;
        color: #050505 !important;
    }
    </style>
{% endblock %}

{% block main %}
    <div class="form-container" role="main" aria-labelledby="artwork-form-title">
        <div class="form-header">
            <div class="title-row">
                <span class="form-title-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M3 21l1.5-4.5L14.5 6l3.5 3.5L7.5 20.5 3 21z" fill="#c7c7d1" />
                      <path d="M20.5 7.5l-3-3a1 1 0 0 0-1.4 0l-1 1 4.4 4.4 1-1a1 1 0 0 0 0-1.4z" fill="#9aa0b3" />
                    </svg>
                </span>
                <h1 id="artwork-form-title">Ajouter une Œuvre</h1>
            </div>  
            <p>Ajoutez une nouvelle œuvre au catalogue et renseignez ses informations.</p>
            <div class="form-divider" aria-hidden="true"></div>
        </div>

        {{ form_start(new_form, {'attr': {
            'class': 'artwork-form',
            'autocomplete': 'off',
            'novalidate':'novalidate',
            'data-color-analysis-url': path('admin_artwork_analyze_upload_colors'),
            'data-color-analysis-token': csrf_token('analyze-artwork-upload-colors')
        }, 'enctype': 'multipart/form-data'}) }}

            <div class="form-grid">

                <div class="form-column">

                    <div class="section">
                        <div class="section-title">Informations de l'œuvre</div>
                        <div class="section-card">
                            <div class="form-row">
                                {{ form_label(new_form.title) }}
                                {{ form_widget(new_form.title, {'attr': {'class': 'field-widget'}}) }}
                                <div class="form-errors">{{ form_errors(new_form.title) }}</div>
                            </div>

                            <div class="form-row">
                                {{ form_label(new_form.technique) }}
                                {{ form_widget(new_form.technique, {'attr': {'class': 'field-widget'}}) }}
                                <div class="form-errors">{{ form_errors(new_form.technique) }}</div>
                            </div>

                            <div class="form-row">
                                {{ form_label(new_form.dimensions) }}
                                {{ form_widget(new_form.dimensions, {'attr': {'class': 'field-widget'}}) }}
                                <div class="form-errors">{{ form_errors(new_form.dimensions) }}</div>
                            </div>

                            <div class="form-row">
                                {{ form_label(new_form.description) }}
                                {{ form_widget(new_form.description, {'attr': {'class': 'field-widget form-textarea'}}) }}
                                <div class="form-errors">{{ form_errors(new_form.description) }}</div>
                            </div>

                            {% if new_form.yearCreated is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.yearCreated) }}
                                    {{ form_widget(new_form.yearCreated, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.yearCreated) }}</div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">Artiste & catégorie</div>
                        <div class="section-card">
                            <div class="form-row">
                                {{ form_label(new_form.artist) }}
                                {{ form_widget(new_form.artist, {'attr': {'class': 'field-widget'}}) }}
                                <div class="form-errors">{{ form_errors(new_form.artist) }}</div>
                            </div>

                            <div class="form-row">
                                {{ form_label(new_form.category) }}
                                {{ form_widget(new_form.category, {'attr': {'class': 'field-widget'}}) }}
                                <div class="form-errors">{{ form_errors(new_form.category) }}</div>
                            </div>

                            <div class="form-row">
                                {{ form_label(new_form.colors) }}
                                {{ form_widget(new_form.colors, {'attr': {'class': 'field-widget'}}) }}
                                {{ form_help(new_form.colors) }}
                                <div class="form-errors">{{ form_errors(new_form.colors) }}</div>
                                <button class="color-analysis-action" type="button" data-analyze-uploaded-colors>
                                    🎨 Détecter les couleurs de l’image
                                </button>
                                <p class="color-analysis-status" data-color-analysis-status aria-live="polite">
                                    Sélectionnez une image dans la section Média pour remplir automatiquement les couleurs.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">Informations commerciales</div>
                        <div class="section-card">
                            {% if new_form.price is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.price) }}
                                    {{ form_widget(new_form.price, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.price) }}</div>
                                </div>
                            {% endif %}

                            {% if new_form.startingPrice is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.startingPrice) }}
                                    {{ form_widget(new_form.startingPrice, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.startingPrice) }}</div>
                                </div>
                            {% endif %}

                            {% if new_form.reservePrice is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.reservePrice) }}
                                    {{ form_widget(new_form.reservePrice, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.reservePrice) }}</div>
                                </div>
                            {% endif %}

                            {% if new_form.increment is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.increment) }}
                                    {{ form_widget(new_form.increment, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.increment) }}</div>
                                </div>
                            {% endif %}

                            {% if new_form.auctionStart is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.auctionStart) }}
                                    {{ form_widget(new_form.auctionStart, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.auctionStart) }}</div>
                                </div>
                            {% endif %}

                            {% if new_form.auctionEnd is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.auctionEnd) }}
                                    {{ form_widget(new_form.auctionEnd, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.auctionEnd) }}</div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                </div>

                <div class="form-column">

                    <div class="section">
                        <div class="section-title">Média</div>
                        <div class="section-card">
                            <div class="upload-drop">
                                <div class="upload-area">
                                    <div class="upload-hint">Cliquez ou glissez-déposez une image<br><small class="small">JPG, PNG, WEBP</small></div>
                                    {{ form_widget(new_form.photo, {'attr': {'class': 'field-widget'}}) }}
                                </div>
                                <div>
                                    <div class="small">Aperçu</div>
                                    <img id="upload-preview" class="upload-preview" src="" alt="Aperçu image" style="display:none" />
                                </div>
                            </div>
                            <div class="form-errors">{{ form_errors(new_form.photo) }}</div>
                            {{ form_row(new_form.images) }}
                            <p class="color-analysis-queue-note">Les couleurs peuvent aussi être détectées avant l’enregistrement depuis le champ « Couleurs principales ».</p>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">Publication</div>
                        <div class="section-card">
                            {% if new_form.status is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.status) }}
                                    {{ form_widget(new_form.status, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.status) }}</div>
                                </div>
                            {% endif %}

                            {% if new_form.dailyFeatured is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.dailyFeatured) }}
                                    {{ form_widget(new_form.dailyFeatured, {'attr': {'class': 'field-widget daily-featured-checkbox'}}) }}
                                    {{ form_help(new_form.dailyFeatured) }}
                                    <div class="form-errors">{{ form_errors(new_form.dailyFeatured) }}</div>
                                </div>
                            {% endif %}

                            {% if new_form.publishedAt is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.publishedAt) }}
                                    {{ form_widget(new_form.publishedAt, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.publishedAt) }}</div>
                                </div>
                            {% endif %}

                            {% if new_form.published is defined %}
                                <div class="form-row">
                                    {{ form_label(new_form.published) }}
                                    {{ form_widget(new_form.published, {'attr': {'class': 'field-widget'}}) }}
                                    <div class="form-errors">{{ form_errors(new_form.published) }}</div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                </div>

                <div class="form-actions" role="group" aria-label="Actions du formulaire">
                    <a href="javascript:history.back()" class="btn-cancel">Annuler</a>
                    <button type="submit" class="btn-submit">Ajouter l'Œuvre</button>
                </div>

            </div>

        {{ form_end(new_form) }}
    </div>
{% endblock %}

{% block configured_javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('admin-artwork-color-analysis.js') }}"></script>
    <script type="module" src="{{ asset('admin-artwork-images.js') }}"></script>
    <script>
        (function () {
            // Prefer selecting the file input inside the upload-area; fallback to id selector
            const fileInput = document.querySelector('.upload-area input[type="file"]') || document.querySelector('[id$="_photo"]');
            const preview = document.getElementById('upload-preview');
            if (!fileInput || !preview) return;

            fileInput.addEventListener('change', function (e) {
                const file = e.target.files && e.target.files[0];
                if (!file || !file.type || !file.type.startsWith('image/')) {
                    preview.style.display = 'none';
                    preview.src = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (ev) {
                    preview.src = ev.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            });

            const uploadArea = document.querySelector('.upload-area');
            if (uploadArea) {
                ['dragenter','dragover'].forEach(evt => uploadArea.addEventListener(evt, function (ev) { ev.preventDefault(); uploadArea.style.borderColor = '#C9A227'; }));
                ['dragleave','drop'].forEach(evt => uploadArea.addEventListener(evt, function (ev) { ev.preventDefault(); uploadArea.style.borderColor = 'rgba(255, 255, 255, 0.12)'; }));
                uploadArea.addEventListener('drop', function (ev) {
                    const dt = ev.dataTransfer; if (!dt || !dt.files || !dt.files.length) return;
                    fileInput.files = dt.files;
                    fileInput.dispatchEvent(new Event('change'));
                });
            }
        })();
    </script>
{% endblock %}