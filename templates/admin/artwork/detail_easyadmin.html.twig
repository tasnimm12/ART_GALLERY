{% extends '@!EasyAdmin/crud/detail.html.twig' %}

{% block configured_stylesheets %}
    {{ parent() }}
    <style>
        body.ea-detail #main {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px 18px;
        }

        body.ea-detail #main .field-group {
            min-width: 0;
            margin: 0;
            padding: 16px 18px;
            border: 1px solid rgba(255, 255, 255, .09);
            border-radius: 10px;
            background: rgba(255, 255, 255, .025);
        }

        body.ea-detail #main .field-label {
            margin-bottom: 7px;
            color: #C9A227;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        body.ea-detail #main .field-value {
            color: #F5F1E9;
            overflow-wrap: anywhere;
        }

        body.ea-detail #main .field-artwork-photo {
            grid-row: span 2;
        }

        body.ea-detail #main .field-artwork-photo img {
            max-width: 100%;
            max-height: 360px;
            border-radius: 8px;
            object-fit: contain;
        }

        @media (max-width: 767px) {
            body.ea-detail #main {
                grid-template-columns: minmax(0, 1fr);
            }

            body.ea-detail #main .field-artwork-photo {
                grid-row: auto;
            }
        }
    </style>
{% endblock %}
