{% extends 'base.html.twig' %}

{% block title %}Gestion des Enchères — Abstract Art Gallery{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body {
    background-color: #050505 !important;
    color: #FFFFFF !important;
}

.admin-container {
    max-width: 1400px;
    margin: 30px auto;
    padding: 0 20px;
}

.admin-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    flex-wrap: wrap;
    gap: 16px;
}

.admin-top-bar h1 {
    font-size: 30px;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 6px 0;
    letter-spacing: -0.02em;
}

.admin-top-bar p {
    color: #A1A1A1;
    margin: 0;
    font-size: 14px;
}

.filter-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 22px;
    flex-wrap: wrap;
}

.filter-tab {
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    color: #A3A3A3;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.10);
    transition: all 0.15s ease;
}

.filter-tab:hover {
    background: #161616;
    color: #FFFFFF;
    border-color: rgba(201, 162, 39, 0.40);
}

.filter-tab.active {
    background: #FFFFFF;
    color: #050505;
    font-weight: 700;
    border-color: #FFFFFF;
}

.filter-tab .badge {
    background: rgba(0, 0, 0, 0.15);
    padding: 2px 6px;
    border-radius: 10px;
    font-size: 11px;
    margin-left: 4px;
}

.auction-table-card {
    background: #0B0B0B;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    overflow: hidden;
}

.auction-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
}

.auction-table th {
    background: #151515;
    padding: 16px 18px;
    text-align: left;
    font-weight: 700;
    color: #A3A3A3;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

.auction-table td {
    padding: 16px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    vertical-align: middle;
    color: #F5F5F5;
}

.auction-table tr:hover {
    background: #161616;
}

.status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.status-ACTIVE {
    background: rgba(201, 162, 39, 0.12);
    border: 1px solid #C9A227;
    color: #E0C766;
}

.status-SCHEDULED {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.20);
    color: #FFFFFF;
}

.status-ENDED, .status-CANCELLED {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #A1A1A1;
}

.action-btn {
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
}

.btn-live {
    background: #C9A227;
    color: #050505;
    font-weight: 700;
}
.btn-live:hover {
    background: #E0C766;
}

.btn-publish, .btn-close, .btn-cancel {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
}
.btn-publish:hover, .btn-close:hover, .btn-cancel:hover {
    border-color: #C9A227;
    color: #C9A227;
}

.btn-new {
    background: #C9A227;
    color: #050505;
    font-weight: 700;
    padding: 10px 18px;
    font-size: 13.5px;
}
.btn-new:hover {
    background: #E0C766;
}

.btn-back {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    padding: 10px 16px;
    font-size: 13.5px;
}
.btn-back:hover {
    border-color: #C9A227;
    color: #C9A227;
}

.flash-msg {
    padding: 14px 18px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-size: 13.5px;
    font-weight: 600;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-left: 3px solid #C9A227;
    color: #FFFFFF;
}
</style>
{% endblock %}

{% block body %}
<div class="admin-container">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-msg">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="admin-top-bar">
        <div>
            <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #C9A227; margin-bottom: 6px;">
                Maison de Vente aux Enchères
            </div>
            <h1>Gestion des Lots d'Enchères</h1>
            <p>Contrôle des ventes aux enchères en temps réel, publication et clôture administrative.</p>
        </div>
        <div style="display: flex; gap: 10px;">
            <a href="{{ path('app_admin_dashboard') }}" class="action-btn btn-back">← Retour au Dashboard</a>
            <a href="{{ path('app_admin_auction_new') }}" class="action-btn btn-new">+ Créer un lot d'enchère</a>
        </div>
    </div>

    {# Filter Tabs #}
    <div class="filter-tabs">
        <a href="{{ path('app_admin_auction_index', {filter: 'all'}) }}" class="filter-tab {% if currentFilter == 'all' %}active{% endif %}">
            Toutes <span class="badge">{{ counts.all }}</span>
        </a>
        <a href="{{ path('app_admin_auction_index', {filter: 'active'}) }}" class="filter-tab {% if currentFilter == 'active' %}active{% endif %}">
            En direct <span class="badge">{{ counts.active }}</span>
        </a>
        <a href="{{ path('app_admin_auction_index', {filter: 'scheduled'}) }}" class="filter-tab {% if currentFilter == 'scheduled' %}active{% endif %}">
            Planifiées <span class="badge">{{ counts.scheduled }}</span>
        </a>
        <a href="{{ path('app_admin_auction_index', {filter: 'closed'}) }}" class="filter-tab {% if currentFilter == 'closed' %}active{% endif %}">
            Clôturées <span class="badge">{{ counts.closed }}</span>
        </a>
        <a href="{{ path('app_admin_auction_index', {filter: 'cancelled'}) }}" class="filter-tab {% if currentFilter == 'cancelled' %}active{% endif %}">
            Annulées <span class="badge">{{ counts.cancelled }}</span>
        </a>
    </div>

    <div class="auction-table-card">
        <table class="auction-table">
            <thead>
                <tr>
                    <th>LOT</th>
                    <th>ŒUVRE / ARTISTE</th>
                    <th>PRIX DE DÉPART</th>
                    <th>PRIX ACTUEL</th>
                    <th>STATUT</th>
                    <th>DÉBUT / FIN</th>
                    <th>GAGNANT</th>
                    <th style="text-align: right;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% for auction in auctions %}
                    {% set status = auction.effectiveStatus %}
                    <tr>
                        <td style="font-weight: 700; color: #C9A227;">#{{ "%03d"|format(auction.id) }}</td>
                        <td>
                            <strong style="color: #FFFFFF;">{{ auction.artwork ? auction.artwork.title : auction.artworkTitle }}</strong><br>
                            <small style="color: #A1A1A1;">{{ auction.artwork and auction.artwork.artist ? auction.artwork.artist.name : auction.artistName }}</small>
                        </td>
                        <td>{{ auction.startingPrice|number_format(2, ',', ' ') }} €</td>
                        <td style="font-weight: 700; color: #FFFFFF;">
                            {{ (auction.currentPrice ?? auction.startingPrice)|number_format(2, ',', ' ') }} €
                        </td>
                        <td>
                            <span class="status-pill status-{{ status }}">
                                {{ status == 'ACTIVE' ? 'EN DIRECT' : (status == 'SCHEDULED' ? 'PLANIFIÉE' : (status == 'ENDED' ? 'CLÔTURÉE' : 'ANNULÉE')) }}
                            </span>
                        </td>
                        <td style="font-size: 12.5px; color: #A1A1A1;">
                            {{ auction.startDate|date('d/m/Y H:i') }}<br>
                            → {{ auction.endDate|date('d/m/Y H:i') }}
                        </td>
                        <td>
                            {% if auction.winner %}
                                <span style="color: #FFFFFF; font-weight: 600;">{{ auction.winner.firstName }} {{ auction.winner.lastName }}</span>
                            {% else %}
                                <span style="color: #737373;">—</span>
                            {% endif %}
                        </td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 6px; align-items:center;">
                                {% if status == 'ACTIVE' %}
                                    <a href="{{ path('app_admin_auction_live', {id: auction.id}) }}" class="action-btn btn-live">
                                        Salle Live ↗
                                    </a>
                                {% endif %}
                                <a href="{{ path('app_admin_auction_live', {id: auction.id}) }}" class="action-btn btn-publish">Détails</a>
                                <a href="{{ path('app_admin_auction_edit', {id: auction.id}) }}" class="action-btn btn-publish">Modifier</a>
                                <form method="post" action="{{ path('app_admin_auction_delete', {id: auction.id}) }}" style="display:inline" onsubmit="return confirm('Confirmer la suppression de ce lot d\'enchère ? Cette action est irréversible.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ auction.id) }}">
                                    <button type="submit" class="action-btn btn-cancel" style="padding:7px 12px;">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" style="text-align: center; color: #A1A1A1; padding: 32px;">
                            Aucun lot d'enchère trouvé.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
