<!DOCTYPE html>
<html lang="fr" class="anim-page">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Abstract Art Gallery{% endblock %}</title>
        <meta name="description" content="Abstract Art Gallery — galerie internationale d'art abstrait contemporain, direct sales and exclusive auctions.">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎨</text></svg>">

        <style>
            :root {
                --aag-bg: #020202;
                --aag-bg-soft: #0d0d0d;
                --aag-panel: #12110f;
                --aag-panel-alt: #181613;
                --aag-border: rgba(255,255,255,0.10);
                --aag-border-strong: rgba(214,177,108,0.68);
                --aag-text: #f8f2ea;
                --aag-text-soft: #f1e4c8;
                --aag-text-muted: #b9a57d;
                --aag-surface-light: #f8f4ef;
                --aag-surface-light-text: #14110f;
                --aag-surface-light-muted: #5d564f;
                --aag-accent: #d9b36a;
                --aag-accent-hover: #c8933d;
                --aag-accent-soft: #f9ebc7;
                --aag-accent-warm: #ebca80;
                --aag-accent-warm-strong: #f5d994;
                --aag-panel-strong: rgba(19,16,12,0.98);
                --aag-panel-soft: rgba(24,20,16,0.86);
                --aag-live: #ff5c52;
                --aag-success: #a9d8b6;
                --aag-warning: #e6c77b;
                --aag-danger: #ef4444;
                --aag-danger-hover: #dc2626;
                --aag-shadow: rgba(0, 0, 0, 0.42);
                --aag-radius: 18px;
                --aag-radius-soft: 12px;
                --aag-max-width: 1280px;
                --aag-font-serif: 'Cormorant Garamond', Georgia, serif;
                --aag-font-sans: 'Inter', 'Segoe UI', sans-serif;
            }

            * { box-sizing: border-box; }
            html { scroll-behavior: smooth; }
            body {
                margin: 0;
                background:
                    radial-gradient(circle at top, rgba(217,179,106,0.18), transparent 18%),
                    radial-gradient(circle at bottom right, rgba(217,179,106,0.08), transparent 16%),
                    linear-gradient(180deg, #010101 0%, #080808 100%);
                color: var(--aag-text);
                font-family: var(--aag-font-sans);
                letter-spacing: -0.01em;
                min-height: 100vh;
                text-rendering: optimizeLegibility;
                -webkit-font-smoothing: antialiased;
            }
            a { color: inherit; text-decoration: none; }
            img { max-width: 100%; display: block; }
            h1,h2,h3,h4,h5,h6 {
                margin: 0;
                font-family: var(--aag-font-serif);
                font-weight: 600;
                letter-spacing: -0.02em;
                line-height: 0.9;
                text-wrap: balance;
            }
            p { margin: 0; }
            .sr-only {
                position: absolute;
                width: 1px; height: 1px;
                padding: 0; margin: -1px; overflow: hidden;
                clip: rect(0,0,0,0); white-space: nowrap; border: 0;
            }
            .navbar {
                position: sticky; top: 0; z-index: 50;
                display: flex; justify-content: space-between; align-items: center;
                gap: 28px; padding: 18px 32px; background: rgba(8,8,8,0.88);
                backdrop-filter: blur(18px); border-bottom: 1px solid rgba(217,179,106,0.26);
                box-shadow: 0 18px 40px rgba(0,0,0,0.24);
            }
            .nav-brand {
                display: inline-flex; align-items: center; gap: 10px;
                color: var(--aag-text); font-size: 0.96rem; font-weight: 700;
                letter-spacing: 0.22em; text-transform: uppercase;
            }
            .nav-brand span:last-child { letter-spacing: 0.08em; }
            .nav-menu {
                display: flex; align-items: center; gap: 22px; list-style: none; margin: 0; padding: 0;
            }
            .nav-link {
                color: var(--aag-text-soft); text-transform: uppercase; font-size: 0.72rem;
                letter-spacing: 0.18em; font-weight: 600; transition: color 0.18s ease;
            }
            .nav-link:hover { color: var(--aag-text); }
            .nav-btn {
                display: inline-flex; align-items: center; justify-content: center; border-radius: 999px;
                border: 1px solid var(--aag-border); padding: 8px 14px; color: var(--aag-text);
                font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;
                transition: all 0.18s ease;
            }
            .nav-btn:hover, .nav-btn:focus-visible {
                transform: translateY(-1px);
                box-shadow: 0 8px 18px rgba(209,169,93,0.18);
            }
            .nav-btn-primary { background: linear-gradient(135deg, var(--aag-accent), var(--aag-accent-warm)); color: #1a1207; border-color: transparent; }
            .nav-btn-danger { background: rgba(239,141,141,0.08); border-color: rgba(239,141,141,0.2); color: #f8d0d0; }
            .nav-btn-outline { background: transparent; border-color: var(--aag-border-strong); }
            .nav-actions {
                display: flex; align-items: center; gap: 10px;
            }
            .nav-icon-btn {
                width: 36px; height: 36px; border-radius: 999px; border: 1px solid var(--aag-border);
                display: inline-flex; align-items: center; justify-content: center; color: var(--aag-text-soft);
                background: rgba(255,255,255,0.01); transition: all 0.18s ease;
            }
            .nav-icon-btn:hover { border-color: var(--aag-border-strong); color: var(--aag-text); box-shadow: 0 8px 18px rgba(200,155,69,0.18); transform: translateY(-1px); }
            .nav-icon-btn svg { width: 16px; height: 16px; }
            .nav-badge {
                position: absolute; top: -4px; right: -6px; min-width: 18px; height: 18px; padding: 0 4px;
                display: inline-flex; align-items: center; justify-content: center; border-radius: 999px;
                font-size: 10px; font-weight: 700; background: var(--aag-accent); color: #111;
            }
            .nav-pill {
                display: inline-flex; align-items: center; justify-content: center; border-radius: 999px;
                border: 1px solid var(--aag-border); background: rgba(255,255,255,0.01);
                padding: 9px 14px; color: var(--aag-text); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
            }
            .main-content {
                width: min(var(--aag-max-width), calc(100% - 56px)); margin: 0 auto; padding: 0 0 72px; flex: 1;
            }
            .aag-section-label {
                display: inline-flex; align-items: center; gap: 10px; margin-bottom: 12px;
                color: var(--aag-accent-soft); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700;
            }
            .aag-section-label::before {
                content: ''; width: 42px; height: 1px; background: rgba(249,235,199,0.6);
            }
            .footer {
                border-top: 1px solid var(--aag-border); background: rgba(0,0,0,0.18); color: var(--aag-text-muted);
                padding: 44px 18px 28px; font-size: 0.82rem;
            }
            .footer-inner {
                width: min(var(--aag-max-width), calc(100% - 48px)); margin: 0 auto;
                display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr; gap: 24px;
            }
            .footer-title { color: var(--aag-text); font-size: 0.76rem; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 16px; }
            .footer-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
            .footer-list a { color: var(--aag-text-soft); }
            .footer-list a:hover { color: var(--aag-text); }
            .newsletter { display: flex; gap: 10px; margin-top: 12px; }
            .newsletter input {
                flex: 1; background: rgba(255,255,255,0.02); border: 1px solid var(--aag-border);
                border-radius: 8px; color: var(--aag-text); padding: 12px 14px; font: inherit;
            }
            .newsletter button {
                border: 0; border-radius: 8px; background: var(--aag-accent); color: #111; font-weight: 700;
                padding: 12px 18px; cursor: pointer;
            }
            .aag-button, .btn {
                display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 14px 26px;
                border: 1px solid transparent; font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase;
                font-weight: 700; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
            }
            .aag-button:hover, .btn:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(217,179,106,0.18); }
            .aag-button--primary, .btn-primary {
                background: linear-gradient(135deg, var(--aag-accent) 0%, var(--aag-accent-warm) 100%);
                color: #1b140b; box-shadow: 0 14px 28px rgba(217,179,106,0.22);
            }
            .aag-button--secondary, .btn-secondary {
                background: transparent; border-color: rgba(217,179,106,0.44); color: var(--aag-text);
            }
            .card-light {
                background: linear-gradient(180deg, #fffdf9 0%, #f7f1e8 100%);
                color: var(--aag-surface-light-text);
                border: 1px solid rgba(15, 23, 42, 0.08);
                border-radius: 20px;
                box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08), 0 2px 10px rgba(0,0,0,0.04);
            }
            .card-light .muted {
                color: var(--aag-surface-light-muted);
            }
            .btn-primary {
                background: var(--aag-accent);
                color: #ffffff;
                border: 1px solid transparent;
            }
            .btn-primary:hover,
            .btn-primary:focus-visible {
                background: var(--aag-accent-hover);
                color: #ffffff;
            }
            .btn-danger {
                background: var(--aag-danger);
                color: #ffffff;
                border: 1px solid transparent;
            }
            .btn-danger:hover,
            .btn-danger:focus-visible {
                background: var(--aag-danger-hover);
                color: #ffffff;
            }
            .btn-light {
                background: var(--aag-surface-light);
                color: var(--aag-surface-light-text);
                border: 1px solid rgba(15, 23, 42, 0.12);
            }
            .btn-light:hover,
            .btn-light:focus-visible {
                background: #f8fafc;
                color: var(--aag-surface-light-text);
            }
            .aag-section-label {
                color: var(--aag-accent); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; display: inline-block; margin-bottom: 16px;
            }
            .global-search {
                display: inline-flex; align-items: center; gap: 8px; margin-right: 4px;
            }
            .global-search-input {
                width: 0; opacity: 0; padding: 0; border: 0; color: var(--aag-text);
                background: transparent; font: inherit; transition: width .2s ease, opacity .2s ease, padding .2s ease;
            }
            .global-search:focus-within .global-search-input,
            .global-search:hover .global-search-input {
                width: 190px; opacity: 1; padding: 8px 10px; border-bottom: 1px solid var(--aag-border-strong);
            }
            .global-search-input:focus { outline: none; }
            .global-search-input::placeholder { color: var(--aag-text-muted); }
            .filter-drawer-backdrop {
                position: fixed; inset: 0; z-index: 90; display: none; background: rgba(0,0,0,.72); backdrop-filter: blur(5px);
            }
            .filter-drawer-backdrop.is-open { display: block; }
            .filter-drawer {
                position: fixed; top: 0; right: 0; z-index: 91; width: min(420px, 100%); height: 100vh; overflow-y: auto;
                padding: 30px 26px; background: #10100f; border-left: 1px solid rgba(217,179,106,.35); box-shadow: -18px 0 45px rgba(0,0,0,.35);
                transform: translateX(100%); transition: transform .25s ease;
            }
            .filter-drawer-backdrop.is-open .filter-drawer { transform: translateX(0); }
            .filter-drawer-header { display:flex; justify-content:space-between; align-items:center; margin-bottom: 28px; }
            .filter-drawer-header h2 { font-size: 1.45rem; color: var(--aag-text); }
            .filter-drawer-close { border: 1px solid rgba(255,255,255,.16); background: transparent; color: var(--aag-text); border-radius: 8px; width: 32px; height: 32px; cursor: pointer; font-size: 1.1rem; }
            .filter-drawer-form { display: grid; gap: 16px; }
            .filter-drawer-field { display: grid; gap: 7px; }
            .filter-drawer-field label { color: var(--aag-text-muted); font-size: .64rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; }
            .filter-drawer-field input, .filter-drawer-field select {
                width: 100%; padding: 11px 12px; border: 1px solid rgba(255,255,255,.14); border-radius: 8px;
                background: rgba(255,255,255,.035); color: var(--aag-text); font: inherit;
            }
            .filter-drawer-field select option { background: #12110f; color: var(--aag-text); }
            .filter-drawer-actions { display: flex; gap: 8px; margin-top: 8px; }
            .filter-drawer-actions button, .filter-drawer-actions a { flex: 1; text-align:center; cursor:pointer; }
            .filter-icon-button { width: 40px; height: 40px; min-width: 40px; padding: 0 !important; display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem; line-height: 1; }
            body.filter-drawer-open { overflow: hidden; }
            @media (max-width: 900px) {
                .nav-brand { letter-spacing: 0.12em; }
                .nav-menu { display: none; }
                .footer-inner { grid-template-columns: 1fr 1fr; }
            }
            @media (max-width: 560px) {
                .navbar { flex-wrap: wrap; gap: 10px 14px; padding: 14px 18px; }
                .nav-brand { font-size: 0.8rem; letter-spacing: 0.14em; }
                .nav-actions { flex: 1 1 100%; flex-wrap: wrap; justify-content: flex-end; gap: 6px; min-width: 0; }
                .main-content { width: min(var(--aag-max-width), calc(100% - 24px)); }
                .footer-inner { grid-template-columns: 1fr; }
                .global-search:focus-within .global-search-input,
                .global-search:hover .global-search-input { width: 120px; }
            }
            .icon-only-nav-link {
                position: relative;
                width: 40px;
                min-width: 40px;
                height: 40px;
                padding: 0;
                font-size: 1.05rem;
                letter-spacing: 0;
            }
            .nav-favorites-count.sr-only { display: inline; }
        </style>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/animations.css') }}">
            {% if app.request.pathInfo starts with '/admin' %}
                <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
            {% else %}
                <link rel="stylesheet" href="{{ asset('styles/ai-chat-widget.css') }}">
            {% endif %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            {% if not (app.request.pathInfo starts with '/admin') %}
                <script type="module" src="{{ asset('ai-chat-widget.js') }}"></script>
            {% endif %}
        {% endblock %}
    </head>
    <body class="{{ app.request.pathInfo starts with '/admin' ? 'admin-backoffice' : '' }}">
        <nav class="navbar anim-enter">
            <a href="{{ path('app_home') }}" class="nav-brand">
                <span>ABSTRACT ART GALLERY</span>
            </a>
            <ul class="nav-menu">
                <li><a href="{{ path('app_catalog_index') }}" class="nav-link">Œuvres</a></li>
                <li><a href="{{ path('app_artist_index') }}" class="nav-link">Artistes</a></li>
                <li><a href="{{ path('app_auction_index') }}" class="nav-link">Enchères</a></li>
                <li><a href="{{ path('app_about') }}" class="nav-link">À propos</a></li>
            </ul>

            <div class="nav-actions">
                <form class="global-search" action="{{ path('app_catalog_index') }}" method="get" role="search">
                    <button type="submit" class="nav-icon-btn" aria-label="Rechercher">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="6"></circle>
                            <path d="M16 16L21 21"></path>
                        </svg>
                    </button>
                    <input class="global-search-input" type="search" name="q" placeholder="Rechercher une œuvre..." aria-label="Rechercher une œuvre">
                </form>
                <button type="button" class="nav-icon-btn" id="open-global-filters" aria-label="Ouvrir les filtres">☷</button>
                <button type="button" class="nav-btn nav-btn-outline ai-assistant-link icon-only-nav-link" data-ai-chat-open aria-label="Ouvrir l’assistant artistique" aria-expanded="false" aria-controls="ai-widget-panel">
                    <span aria-hidden="true">🤖</span>
                </button>
                <a href="{{ path('app_ai_advisor') }}" class="nav-btn nav-btn-outline ai-assistant-link icon-only-nav-link" aria-label="AI Art Advisor">
                    <span aria-hidden="true">✦</span>
                </a>
                <a href="{{ path('app_cart_index') }}" class="nav-icon-btn" aria-label="Panier" style="position: relative;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 7h12l-1.2 9.4a2 2 0 0 1-2 1.6H9.2a2 2 0 0 1-2-1.6L6 7Z"></path>
                        <path d="M9 7V6a3 3 0 0 1 6 0v1"></path>
                    </svg>
                    {% set ccount = cart_count() %}
                    {% if ccount > 0 %}
                        <span class="nav-badge">{{ ccount }}</span>
                    {% endif %}
                </a>
                {% if app.user %}
                    <a href="{{ path('app_account_favorites') }}" class="nav-btn nav-btn-outline nav-favorites-link icon-only-nav-link" aria-label="Favoris">
                        <span aria-hidden="true">♡</span>
                        <span class="nav-favorites-count sr-only" data-favorites-count>{{ app.user.favorites|length }}</span>
                    </a>
                    <a href="{{ path('app_account') }}" class="nav-icon-btn" aria-label="Compte">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 21a8 8 0 0 0-16 0"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="nav-btn nav-btn-outline">Admin</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="nav-btn nav-btn-danger">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-link">Connexion</a>
                    <a href="{{ path('app_register') }}" class="nav-btn nav-btn-primary">Inscription</a>
                {% endif %}
            </div>
        </nav>

        <div class="filter-drawer-backdrop" id="global-filter-backdrop" aria-hidden="true">
            <aside class="filter-drawer" role="dialog" aria-modal="true" aria-labelledby="global-filter-title">
                <div class="filter-drawer-header">
                    <h2 id="global-filter-title">Affiner la collection</h2>
                    <button type="button" class="filter-drawer-close" id="close-global-filters" aria-label="Fermer">×</button>
                </div>
                <form class="filter-drawer-form" action="{{ path('app_catalog_index') }}" method="get">
                    <div class="filter-drawer-field">
                        <label for="global-filter-q">Recherche</label>
                        <input id="global-filter-q" type="search" name="q" placeholder="Titre, artiste, technique...">
                    </div>
                    <div class="filter-drawer-field">
                        <label for="global-filter-category">Catégorie</label>
                        <select id="global-filter-category" name="category">
                            <option value="">Toutes les catégories</option>
                            {% for category in catalog_categories %}
                                <option value="{{ category.id }}">{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="filter-drawer-field">
                        <label for="global-filter-artist">Artiste</label>
                        <select id="global-filter-artist" name="artist">
                            <option value="">Tous les artistes</option>
                            {% for artist in catalog_artists %}
                                <option value="{{ artist.id }}">{{ artist.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="filter-drawer-field">
                        <label for="global-filter-status">Disponibilité</label>
                        <select id="global-filter-status" name="status">
                            <option value="">Tous les statuts</option>
                            <option value="AVAILABLE">Disponible à l'achat</option>
                            <option value="AUCTION">En enchère</option>
                            <option value="RESERVED">Réservé</option>
                            <option value="SOLD">Vendu</option>
                        </select>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <div class="filter-drawer-field"><label for="global-filter-min">Prix min (€)</label><input id="global-filter-min" type="number" name="minPrice" min="0" step="0.01" placeholder="0"></div>
                        <div class="filter-drawer-field"><label for="global-filter-max">Prix max (€)</label><input id="global-filter-max" type="number" name="maxPrice" min="0" step="0.01" placeholder="10000"></div>
                    </div>
                    <div class="filter-drawer-actions">
                        <a class="aag-button aag-button--secondary filter-icon-button" href="{{ path('app_catalog_index') }}" aria-label="Réinitialiser les filtres" title="Réinitialiser les filtres">↺</a>
                        <button class="aag-button aag-button--primary filter-icon-button" type="submit" aria-label="Appliquer les filtres" title="Appliquer les filtres">⌕</button>
                    </div>
                </form>
            </aside>
        </div>

        <main class="main-content">
            {% block body %}{% endblock %}
        </main>

        <footer class="footer">
            <div class="footer-inner">
                <div>
                    <div class="footer-title">Abstract Art Gallery</div>
                    <p>Galerie internationale d'art abstrait contemporain, sélection d'œuvres uniques et enchères exclusives.</p>
                </div>
                <div>
                    <div class="footer-title">Navigation</div>
                    <ul class="footer-list">
                        <li><a href="{{ path('app_catalog_index') }}">Œuvres</a></li>
                        <li><a href="{{ path('app_artist_index') }}">Artistes</a></li>
                        <li><a href="{{ path('app_auction_index') }}">Enchères</a></li>
                        <li><a href="{{ path('app_about') }}">À propos</a></li>
                    </ul>
                </div>
                <div>
                    <div class="footer-title">Services</div>
                    <ul class="footer-list">
                        <li><a href="{{ path('app_home') }}">Livraison</a></li>
                        <li><a href="{{ path('app_home') }}">Authenticité</a></li>
                        <li><a href="{{ path('app_home') }}">Paiement sécurisé</a></li>
                        <li><a href="{{ path('app_home') }}">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <div class="footer-title">Légal</div>
                    <ul class="footer-list">
