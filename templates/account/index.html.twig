{% extends 'base.html.twig' %}

{% block title %}Mon Compte - Abstract Art Gallery{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .account-container {
            max-width: 900px;
            margin: 40px auto 50px;
            padding: 30px;
            background: linear-gradient(180deg, rgba(18,16,13,0.92), rgba(17,17,17,0.82));
            color: var(--aag-text);
            border-radius: 28px;
            border: 1px solid rgba(209,169,93,0.2);
            box-shadow: 0 22px 42px rgba(0,0,0,0.15);
        }

        .account-header {
            display: flex; justify-content: space-between; align-items: center; gap: 18px;
            border-bottom: 1px solid var(--aag-border);
            padding-bottom: 20px; margin-bottom: 25px;
        }

        .account-header h1 {
            font-size: clamp(2.2rem, 3vw, 3.2rem);
            color: var(--aag-text);
            margin: 0;
            letter-spacing: -0.05em;
            line-height: 0.9;
        }

        .account-actions {
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        }

        .account-link {
            color: var(--aag-accent-soft); text-decoration: none; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
        }

        .btn-logout {
            padding: 10px 16px; background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25); color: #f7c0c0; text-decoration: none; border-radius: 999px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
        }

        .btn-logout:hover, .btn-logout:focus-visible { background: rgba(239,68,68,0.14); }

        .info-card {
            background: rgba(255,255,255,0.02); border: 1px solid var(--aag-border); border-radius: 20px; padding: 22px 20px; margin-bottom: 20px;
        }

        .info-card h3 {
            margin: 0 0 16px; color: var(--aag-text); font-size: 1.2rem;
        }

        .info-row {
            display: grid; grid-template-columns: minmax(150px, 220px) 1fr; gap: 12px; margin-bottom: 14px; font-size: 0.96rem;
        }

        .info-label {
            font-weight: 600; color: var(--aag-text-muted);
        }

        .info-value {
            color: var(--aag-text-soft);
        }

        .badge {
            display: inline-block; padding: 5px 10px; background: rgba(209,169,93,0.12); color: var(--aag-accent-soft); border: 1px solid rgba(209,169,93,0.25); border-radius: 999px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-right: 6px; margin-bottom: 6px;
        }

        .alert-success {
            background: rgba(169,216,182,0.08); border: 1px solid rgba(169,216,182,0.22); color: var(--aag-success); padding: 12px 16px; border-radius: 12px; font-size: 0.92rem; margin-bottom: 20px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="account-container">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="account-header">
        <h1>Mon Espace Client</h1>
        <div>
            <a href="{{ path('app_order_history') }}" style="margin-right: 10px; color: var(--aag-accent); text-decoration: none; font-weight: 600;">📦 Mes Commandes</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_dashboard') }}" style="margin-right: 10px; color: var(--aag-accent); text-decoration: none; font-weight: 600;">Espace Admin &rarr;</a>
            {% endif %}
            <a href="{{ path('app_logout') }}" class="btn-logout">Déconnexion</a>
        </div>
    </div>

    <div class="info-card">
        <h3>Informations Personnelles</h3>
        <div class="info-row">
            <div class="info-label">Prénom & Nom :</div>
            <div class="info-value">{{ user.firstName }} {{ user.lastName }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Adresse Email :</div>
            <div class="info-value">{{ user.email }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Téléphone :</div>
            <div class="info-value">{{ user.phone|default('Non renseigné') }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Statut :</div>
            <div class="info-value">{{ user.status }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Rôles :</div>
            <div class="info-value">
                {% for role in user.roles %}
                    <span class="badge">{{ role }}</span>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
